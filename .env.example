# ============================================================
# STOCHOPS Nonprofit Suite — أسماء المتغيرات فقط (بدون أي أسرار)
# انسخه إلى .env محلياً واملأ القيم. لا تُرفع .env إلى Git إطلاقاً.
# ============================================================

# ---- بيئة التشغيل ----
FRAPPE_SITE_NAME=nonprofit.localhost
DEVELOPER_MODE=1            # 1 أثناء التطوير فقط، 0 في الإنتاج
TIMEZONE=Asia/Riyadh

# ---- قاعدة البيانات (تُدار عبر bench/Docker عادة) ----
DB_HOST=
DB_PORT=
DB_NAME=
DB_ROOT_USER=
# لا تضع كلمات المرور هنا؛ تُدار عبر bench أو secret manager

# ---- Redis (يرافق بيئة Frappe) ----
REDIS_CACHE=
REDIS_QUEUE=

# ---- البريد (SMTP) — مؤجّل، لا تفعّله في MVP بدون موافقة ----
SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
# SMTP password/API key يُدار عبر إعدادات الموقع لا هنا

# ---- AI Provider — موقوف افتراضياً (Sprint 6 المؤجّل) ----
AI_ENABLED=false           # يبقى false حتى موافقة مكتوبة على البيانات والتكلفة
AI_PROVIDER=mock           # mock | (مزود لاحق بعد الموافقة)
# AI_API_KEY يُدار عبر secret manager فقط، لا يوضع في Git أبداً
