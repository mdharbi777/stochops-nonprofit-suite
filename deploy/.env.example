# قالب بيئة النشر التجريبي — انسخه إلى .env وعدّل القيم.
# لا تضع أسراراً حقيقية في Git. ملف .env يبقى على الخادم فقط.

# الصورة المخصّصة التي بُنيت محلياً على الخادم (Frappe v15 + منصة الفاضل):
CUSTOM_IMAGE=alfadil/trial
CUSTOM_TAG=latest
PULL_POLICY=never

# اسم الموقع = عنوان IP العام للخادم متبوعاً بـ sslip.io (للحصول على HTTPS مجاني بلا نطاق).
# استبدل REPLACE_IP بعنوان الخادم، مثال: SITES=`1.2.3.4.sslip.io`
SITES=`REPLACE_IP.sslip.io`

# إلزامي لإعداد HTTPS (Traefik): قاعدة التوجيه لنفس اسم الموقع. بدونها يفشل التشغيل بـ"SITES_RULE not set".
SITES_RULE=Host(`REPLACE_IP.sslip.io`)

# كلمة مرور قاعدة البيانات (قوية) — سرّية:
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# بريد إصدار شهادة Let's Encrypt:
LETSENCRYPT_EMAIL=ops@stochops.com

# ---- البريد الصادر عبر Resend (اختياري للتجربة؛ إلزامي إن أردت اختبار الرسائل) ----
# ملاحظة مثبتة عملياً: استخدم المنفذ 587 مع STARTTLS (المنفذ 465/SSL لا يعمل عبر إعداد الموقع).
# تُضبط هذه عبر bench set-config بعد إنشاء الموقع (المفتاح سرّي، لا يوضع هنا):
#   bench --site $SITE set-config -g mail_server smtp.resend.com
#   bench --site $SITE set-config -g mail_port 587
#   bench --site $SITE set-config -g use_tls 1
#   bench --site $SITE set-config -g use_ssl 0
#   bench --site $SITE set-config -g mail_login resend
#   bench --site $SITE set-config    auto_email_id ops@stochops.com
#   bench --site $SITE set-config    mail_password "<RESEND_API_KEY>"   # سرّي
