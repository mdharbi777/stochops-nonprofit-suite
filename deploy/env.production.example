# ============================================================
# frappe_docker — إعداد الإنتاج (أسماء المتغيّرات + قيم نموذجية فقط، بلا أسرار)
# انسخه إلى `.env` بجانب compose.yaml على الخادم، واملأ القيم. لا تُرفع .env إلى Git.
# ============================================================

# ---- نسخة Frappe / الصورة ----
# ثبّت وسماً دقيقاً للإنتاج (مثل v15.x.x). بيئة التطوير استخدمت Frappe 15.123.1.
FRAPPE_VERSION=v15

# الصورة المخصّصة التي تبنيها (Frappe + تطبيق stochops_nonprofit)
CUSTOM_IMAGE=ghcr.io/__OWNER__/stochops-nonprofit
CUSTOM_TAG=v0.5.0
PULL_POLICY=always

# ---- قاعدة البيانات ----
# كلمة مرور قوية تُولّد وتُحفظ في secret manager — لا تضعها في Git.
DB_PASSWORD=__SET_STRONG_PASSWORD__

# ---- الموقع والنطاق ----
# لاحظ علامات backtick كما يتوقّعها frappe_docker.
SITES=`nonprofit.example.sa`

# بريد إصدار شهادة SSL (Let's Encrypt)
LETSENCRYPT_EMAIL=ops@example.sa

# منفذ نشر الواجهة خلف البروكسي العكسي
HTTP_PUBLISH_PORT=8080

# ---- Redis (تُدار عبر compose overrides عادةً) ----
REDIS_CACHE=redis://redis-cache:6379
REDIS_QUEUE=redis://redis-queue:6379

# ملاحظة: بيانات الاعتماد الإدارية للموقع (Administrator password) تُمرَّر وقت
# إنشاء الموقع فقط (bench new-site) ولا تُخزَّن هنا.
